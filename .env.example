# Environment variable template

# Advertising network configuration
# Choose one ad network: 'adsense' (default) or 'exoclick'
NEXT_PUBLIC_AD_NETWORK=adsense

# AdSense settings
NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT=1234567890

# ExoClick settings (only if NEXT_PUBLIC_AD_NETWORK=exoclick)
NEXT_PUBLIC_EXOCLICK_PID=123456
NEXT_PUBLIC_EXOCLICK_ZONE=7890123

# Plausible analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

