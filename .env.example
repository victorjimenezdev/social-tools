# .env.example (default environment variables template)

# Ad configuration
NEXT_PUBLIC_AD_NETWORK=adsense  # 'adsense' (default) or 'exoclick'
NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT=1234567890
NEXT_PUBLIC_EXOCLICK_PID=123456
NEXT_PUBLIC_EXOCLICK_ZONE=7890123

# Plausible analytics domain
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

